{
  "name": "koren-code-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --only correctness --skip correctness/useImportExtensions --skip correctness/useQwikValidLexicalScope src",
    "test": "vitest run",
    "benchmark:phase9a": "vitest run src/app/developerTools.perf.test.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^22.15.30",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.1.0"
  }
}
